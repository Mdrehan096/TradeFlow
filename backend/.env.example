# Server port (Render injects PORT automatically in production)
PORT=3002

# MongoDB connection string (MongoDB Atlas or local mongodb://127.0.0.1:27017/tradeflow)
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/tradeflow?retryWrites=true&w=majority

# Comma-separated or single allowed browser origins for production CORS
FRONTEND_URL=https://your-frontend.vercel.app
DASHBOARD_URL=https://your-dashboard.vercel.app

# Optional: override DNS servers (useful on restricted local networks; omit on Render)
# DNS_SERVERS=8.8.8.8,8.8.4.4

